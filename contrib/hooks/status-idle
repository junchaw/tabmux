#!/bin/sh
# Placeholder/demo hook. Copy to ~/.config/tabmux/hooks/status-idle and chmod +x.
# tabmux runs this when a tab's status changes to idle.
# Replace the body with whatever you actually want (notify, log, etc.).

exec >>/tmp/tabmux-hook.log 2>&1
echo "$(date -Is) idle session=${TABMUX_SESSION-} prev=${TABMUX_PREV_STATUS-}"
